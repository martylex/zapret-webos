# Publish only the source files listed here. Local TV diagnostics stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/app/
!/config/
!/native/
!/tools/
!/docs/
!/source/
!/.github/

/app/*
!/app/appinfo.json
!/app/index.html
!/app/app.js
!/app/style.css
!/app/strategies.js
!/app/icon.png

/config/*
!/config/user-domains.txt

/native/*
!/native/engine.py
!/native/packets.py
!/native/quic.py
!/native/control.py
!/native/startup.sh
!/native/strategies.py
!/native/strategy_catalog.json
!/native/receive.py
!/native/install_tv.py

/tools/*
!/tools/build_ipk.py
!/tools/build_strategies.py
!/tools/verify_ipk.py
!/tools/build_install_script.py
!/tools/test_ui.js
!/tools/test_strategies.py
!/tools/test_receive.py
!/tools/Invoke-TV.ps1
!/tools/ssh-askpass.cs
!/tools/tv-state.sh
!/tools/tv-stop-installed.sh

/docs/*
!/docs/installation.md
!/docs/compatibility.md
!/docs/development.md
!/docs/publishing.md
!/docs/release-0.2.1.md
!/docs/strategy-results.md

/source/*
!/source/flowseal-1.10.4/
/source/flowseal-1.10.4/*
!/source/flowseal-1.10.4/README.webos.md
!/source/flowseal-1.10.4/LICENSE.txt
!/source/flowseal-1.10.4/general*.bat
!/source/flowseal-1.10.4/bin/
!/source/flowseal-1.10.4/lists/
/source/flowseal-1.10.4/bin/*
!/source/flowseal-1.10.4/bin/*.bin
/source/flowseal-1.10.4/lists/*
!/source/flowseal-1.10.4/lists/*.txt

__pycache__/
*.py[cod]
*.log
.env*
*.pem
*.key
